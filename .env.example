APP_NAME=Iskander AI Trade
MODE=paper
# Generate a unique secret of at least 32 characters; never commit the real value.
DASHBOARD_TOKEN=replace-with-a-unique-64-character-random-secret
AUTO_PAPER_ENABLED=true
SCHEDULER_GRACE_SECONDS=8
QUOTE_ASSET=USDT
WATCHLIST=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT
TIMEFRAME=15m
CANDLE_LIMIT=180
POLL_SECONDS=900
VIRTUAL_CAPITAL_USDT=70
RISK_PER_TRADE_USDT=0.35
MAX_DAILY_LOSS_USDT=1.40
MAX_OPEN_POSITIONS=3
MAX_POSITION_NOTIONAL_USDT=20
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
EMA_FAST=20
EMA_SLOW=50
STATE_PATH=data/paper_state.json
LOG_LEVEL=INFO
